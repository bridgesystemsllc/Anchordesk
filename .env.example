# Anchor Desk — server configuration
# Copy to .env and fill in. Never commit .env.

NODE_ENV=development
PORT=4180
LOG_LEVEL=info

# --- Database ---------------------------------------------------------------
# Local: docker compose up -d  (see docker-compose.yml)
DATABASE_URL=postgres://anchor:anchor@127.0.0.1:5432/anchor

# --- Entra ID / Microsoft Graph ---------------------------------------------
# App registration in the KarEve tenant. Application permissions, admin consent
# required.
#
#   Mail.ReadWrite   (Application)
#   Mail.Send        (Application)
#   User.Read.All    (Application)
#
# NOTE: Mail.ReadWrite.Shared and Mail.Send.Shared are DELEGATED-only and cannot
# be granted app-only, despite what the original spec listed. The application
# permissions above reach EVERY mailbox in the tenant, so they must be scoped
# with an Exchange application access policy limited to the five brand
# addresses:
#
#   New-ApplicationAccessPolicy -AppId <client-id> \
#     -PolicyScopeGroupId anchor-desk-mailboxes@kareve.com \
#     -AccessRight RestrictAccess \
#     -Description "Anchor Desk — brand support mailboxes only"
#
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=

# --- Webhooks ---------------------------------------------------------------
# Public HTTPS base URL Graph calls back on. No trailing slash. Graph will not
# accept an http:// or non-resolvable URL. For local development use a tunnel
# (e.g. `cloudflared tunnel --url http://localhost:4180`) or set
# ENABLE_SUBSCRIPTIONS=false and rely on delta reconciliation.
PUBLIC_BASE_URL=https://anchor.kareve.com

# Secret mixed into each mailbox's clientState. Generate once and keep stable:
#   openssl rand -hex 32
GRAPH_CLIENT_STATE_SECRET=

# --- Mailboxes --------------------------------------------------------------
# Config, not constants. `userId` is the value used in /users/{id} — the Entra
# object id or the mailbox UPN. Carol's Daughter may move with the L'Oréal
# separation; that is a change here, not a deploy.
MAILBOXES=[{"brand":"CD","address":"care@carolsdaughter.com","userId":"care@carolsdaughter.com","displayName":"Carol's Daughter Care"},{"brand":"DB","address":"support@dermablend.com","userId":"support@dermablend.com","displayName":"Dermablend Support"},{"brand":"BOC","address":"hello@baxterofcalifornia.com","userId":"hello@baxterofcalifornia.com","displayName":"Baxter of California"},{"brand":"AMBI","address":"care@ambiskincare.com","userId":"care@ambiskincare.com","displayName":"Ambi Care"},{"brand":"AF","address":"help@acnefree.com","userId":"help@acnefree.com","displayName":"AcneFree Care"}]

# --- Jobs -------------------------------------------------------------------
SCHEDULER_INTERVAL_MS=300000
SUBSCRIPTION_RENEW_LEAD_MS=86400000
RECONCILE_INTERVAL_MS=900000
ENABLE_SUBSCRIPTIONS=true
ENABLE_SCHEDULER=true

# --- API --------------------------------------------------------------------
# Bearer token for the ticket read API until Entra SSO lands. REQUIRED in
# production; the server refuses to boot without it.
#   openssl rand -hex 32
API_AUTH_TOKEN=
